# Copy to .env.local only after creating a dedicated Growth Engine Firebase project.
# These are public Firebase web-app configuration values, not service-account credentials.
# Never point this frontend at the production AnyTrader Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APPCHECK_SITE_KEY=
